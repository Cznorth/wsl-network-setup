# Residential SOCKS5 endpoint
RES_HOST=216.151.247.12
RES_PORT=443
RES_USER=replace_me
RES_PASS=replace_me

# Keep 1 when using the existing WSL -> Windows Clash -> residential chain.
# Set 0 if the residential endpoint accepts direct connections.
USE_CLASH=1
CLASH_HOST=host.docker.internal
CLASH_PORT=7890
DNS_UPSTREAM=8.8.8.8:53

# Build mirrors. Remove or override these to use the official sources.
UBUNTU_IMAGE=docker.m.daocloud.io/library/ubuntu:24.04
APT_MIRROR=mirrors.aliyun.com
GOST_DOWNLOAD_BASE=https://ghfast.top/https://github.com/ginuerzh/gost/releases/download

# Published ports inside Docker and on the host.
HTTP_PORT=7895
SOCKS_PORT=7896
PROXY_BIND_ADDRESS=127.0.0.1
