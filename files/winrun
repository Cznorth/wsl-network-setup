#!/usr/bin/env python3
# 随 wsl-network-setup 安装到容器 /usr/local/bin；默认连本机 Docker Desktop 宿主的 Windows OpenSSH
# winrun [-e K=V]... <exe> [args...]：经 SSH 在 Windows 上执行（cwd 自动映射到 X:\...），返回远端退出码
import os, re, subprocess, sys
env, a = [], sys.argv[1:]
while len(a) >= 2 and a[0] == '-e':
    env.append(a[1]); a = a[2:]
for kv in os.environ.get('WSLENV', '').split(':'):          # 兼容原脚本的 WSLENV 传参
    k = kv.split('/')[0]
    if k and k in os.environ: env.append(f'{k}={os.environ[k]}')
def q(s):
    return '"' + s.replace('"', '\\"') + '"' if (not s or re.search(r'[\s&|<>^()"%,;=]', s)) else s
pre = 'chcp 65001 >nul'
m = re.match(r'^/mnt/([a-zA-Z])(/.*)?$', os.getcwd())
if m: pre += f' & cd /d "{m.group(1).upper()}:{(m.group(2) or "/").replace("/", chr(92))}"'
for kv in env: pre += f' & set "{kv}"'
cmd = pre + ' & ' + ' '.join(q(x) for x in a)
user = os.environ.get('WIN_SSH_USER', '')
if not user:
    sys.exit('winrun: 未设置 WIN_SSH_USER（Windows 用户名）')
key = os.environ.get('WIN_SSH_KEY', os.path.expanduser('~/.ssh/winssh'))
r = subprocess.run(['ssh', '-i', key, '-p', os.environ.get('WIN_SSH_PORT', '22'), '-o', 'IdentitiesOnly=yes', '-o', 'BatchMode=yes',
                    '-o', 'StrictHostKeyChecking=accept-new', '-o', 'UserKnownHostsFile=' + os.path.expanduser('~/.ssh/known_hosts_win'),
                    '-o', 'ServerAliveInterval=30', '-o', 'LogLevel=ERROR',
                    f"{user}@{os.environ.get('WIN_SSH_HOST', 'host.docker.internal')}", cmd])
sys.exit(r.returncode)
