[Unit]
Description=gost - Windows 用长期代理端口(经 Clash 链式 → 住宅 SOCKS5)
After=network.target

[Service]
Type=simple
User=__USER__
EnvironmentFile=/etc/gost.env
# 兜底默认值;/etc/gost.env 里的 WIN_HTTP_PORT / WIN_SOCKS_PORT 优先
Environment=WIN_HTTP_PORT=7893
Environment=WIN_SOCKS_PORT=7894
ExecStart=/usr/local/bin/gost -L=http://:${WIN_HTTP_PORT} -L=socks5://:${WIN_SOCKS_PORT} -F=socks5://${CLASH_GW}:${CLASH_PORT} -F=socks5://${RES_USER}:${RES_PASS}@${RES_HOST}:${RES_PORT}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
