# 复制为 wslproxy.env 后填写(wslproxy.env 已在 .gitignore,不会被提交)
# 安装时写入 /etc/gost.env(600,root)。值不能含 @ : / 空白 $ 引号 \ #

# 住宅 SOCKS5(只放行国外来源,必须经 Clash 链式到达)
RES_HOST=<RES_IP>
RES_PORT=443
RES_USER=<user>
RES_PASS=<pass>

# Windows Clash 的 mixed/socks 端口(需开 Allow LAN);WSL 经网关 IP 访问
CLASH_PORT=7890

# dnsfwd 上游 DNS(经住宅以 TCP 查询)
DNS_UPSTREAM=8.8.8.8:53

# WSL 暴露给 Windows 的长期端口(gost-winproxy 监听 0.0.0.0,Windows 用 <WSL_IP>:端口 访问)
# 装完后改这两个值 + sudo systemctl restart gost-winproxy(或新开终端)即生效
WIN_HTTP_PORT=7893
WIN_SOCKS_PORT=7894
